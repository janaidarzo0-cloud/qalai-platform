# Local PostgreSQL. Replace with a Supabase Postgres connection string in hosted environments.
DATABASE_URL=postgresql://qalai:qalai_local_only@localhost:5432/qalai
# Use a direct connection for migrations when the runtime URL uses a transaction pooler.
DATABASE_DIRECT_URL=postgresql://qalai:qalai_local_only@localhost:5432/qalai
# Base64-encoded Supabase CA certificate. Required only for hosted Supabase connections.
DATABASE_CA_CERT_BASE64=
# Explicit opt-in for disposable local schema push. Keep false when using migrations.
PAYLOAD_DB_PUSH=false

# Generate a long random value. Never expose this through a NEXT_PUBLIC_ variable.
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
QALAI_CONTENT_MODE=demo
# Fail closed. Public indexing requires all three values plus CMS mode and an exact HTTPS origin.
QALAI_ALLOW_INDEXING=false
QALAI_PUBLIC_LAUNCH_APPROVED=false
QALAI_INDEXABLE_HOST=
QALAI_PUBLIC_CONTACT_EMAIL=
# Explicit one-run opt-in for importing six closed-alpha drafts for five tasks. Never publish them from seed.
QALAI_ALLOW_ALPHA_SEED=false

# Media is stored under .data/media only in local development and tests.
# Every production build/deployment must use a durable S3-compatible bucket (Supabase Storage-ready).
QALAI_MEDIA_STORAGE=local
QALAI_MEDIA_LOCAL_DIR=.data/media
QALAI_MEDIA_S3_BUCKET=
QALAI_MEDIA_S3_ENDPOINT=
QALAI_MEDIA_S3_REGION=
QALAI_MEDIA_S3_ACCESS_KEY_ID=
QALAI_MEDIA_S3_SECRET_ACCESS_KEY=
# Exact public bucket base URL, without a filename or query string.
QALAI_MEDIA_PUBLIC_BASE_URL=

# Analytics is disabled by default. All values below are server-only secrets/configuration.
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=staging
ANALYTICS_PROVIDER=none
# Use a separate random secret (32+ characters); never reuse PAYLOAD_SECRET.
ANALYTICS_HASH_SECRET=
# Required only when ANALYTICS_PROVIDER=ga4. Use a dedicated staging stream in staging.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
