# Local PostgreSQL. Replace with a Supabase Postgres connection string in hosted environments.
DATABASE_URL=postgresql://qalai:qalai_local_only@localhost:5432/qalai
# Use a direct connection for migrations when the runtime URL uses a transaction pooler.
DATABASE_DIRECT_URL=postgresql://qalai:qalai_local_only@localhost:5432/qalai
# Explicit opt-in for disposable local schema push. Keep false when using migrations.
PAYLOAD_DB_PUSH=false

# Generate a long random value. Never expose this through a NEXT_PUBLIC_ variable.
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
QALAI_CONTENT_MODE=demo

# Analytics is disabled by default. All values below are server-only secrets/configuration.
ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=staging
ANALYTICS_PROVIDER=none
# Use a separate random secret (32+ characters); never reuse PAYLOAD_SECRET.
ANALYTICS_HASH_SECRET=
# Required only when ANALYTICS_PROVIDER=ga4. Use a dedicated staging stream in staging.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
